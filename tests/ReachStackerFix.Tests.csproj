<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Cities2ManagedPath Condition="'$(Cities2ManagedPath)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</Cities2ManagedPath>
    <Cities2ManagedPath Condition="'$(Cities2ManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</Cities2ManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../QueryGuard.cs" Link="QueryGuard.cs" Condition="Exists('../QueryGuard.cs')" />
    <Reference Include="Unity.Entities"><HintPath>$(Cities2ManagedPath)\Unity.Entities.dll</HintPath></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(Cities2ManagedPath)\Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(Cities2ManagedPath)\Unity.Mathematics.dll</HintPath></Reference>
    <Reference Include="Unity.Burst"><HintPath>$(Cities2ManagedPath)\Unity.Burst.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Cities2ManagedPath)\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
